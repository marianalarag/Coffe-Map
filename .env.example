VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA

# Coffee Map uses OpenFreeMap Liberty by default (no API key or registration).
# Optional style or raster overrides for another licensed provider.
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional admin-only enrichment adapter. It must be a server endpoint that
# returns candidates for address, neighborhood, opening_hours and image_url.
# Never expose provider/API secrets in VITE_* variables.
VITE_CAFE_ASSISTANT_URL=
